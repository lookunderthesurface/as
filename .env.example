# Copy to .env only if you want local configuration. Never commit real secrets.
SCREENPIPE_BASE_URL=http://127.0.0.1:3030
SCREENPIPE_API_KEY=
CAPTURE_PROVIDER=screenpipe
SCREENPIPE_MODE=managed
INFERENCE_PROVIDER=mock
CLOUD_PROVIDER=mock
SECRETARY_DB_PATH=data/state.db
SECRETARY_MAX_NOTIFICATIONS_PER_HOUR=2
SECRETARY_NOTIFICATION_COOLDOWN_SECONDS=300
SECRETARY_WATCH_EXPIRATION_MINUTES=20
SECRETARY_MAX_ACTIVE_HYPOTHESES=3
POLICY_REMEMBER_MIN_CONFIDENCE=0.75
POLICY_REMEMBER_MIN_IMPORTANCE=0.50
POLICY_WATCH_MIN_CONFIDENCE=0.65
POLICY_WATCH_MIN_IMPORTANCE=0.50
POLICY_INVESTIGATE_MIN_CONFIDENCE=0.70
POLICY_INVESTIGATE_MIN_IMPORTANCE=0.60
POLICY_NOTIFY_MIN_CONFIDENCE=0.80
POLICY_NOTIFY_MIN_IMPORTANCE=0.75
POLICY_NOTIFY_MIN_INTERRUPT_SCORE=0.70
POLICY_NOTIFY_MIN_WATCH_EVIDENCE=2
SECRETARY_SHADOW_MODE=false
SCREENPIPE_SUPERVISION_INTERVAL=10
SECRETARY_EXCLUDED_APPS=1Password,KeePass
INFERENCE_MIN_INTERVAL_SECONDS=10
INFERENCE_MAX_PENDING_REQUESTS=1
INFERENCE_STALE_REQUEST_SECONDS=30
VISION_COOLDOWN_SECONDS=30
INFERENCE_MAX_TEXT_CHARS=6000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen3-vl:2b-instruct-q4_K_M
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct-q4_K_M
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0
# Confirmed against qwen3-vl:2b-instruct-q4_K_M API smoke.
OLLAMA_THINK=false
VISION_MAX_LONG_EDGE=1280
VISION_JPEG_QUALITY=85
